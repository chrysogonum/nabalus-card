    "srt": "node scripts/generate-srt.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.441",
    "@remotion/google-fonts": "4.0.441",
    "@remotion/media": "4.0.441",
    "@remotion/transitions": "4.0.441",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.441"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "typescript": "5.9.3"
  }
